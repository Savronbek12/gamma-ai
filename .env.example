# Ushbu faylni ".env" nomi bilan nusxalang va kalitingizni kiriting.

# Qaysi sun'iy intellekt ishlatiladi: groq (bepul), gemini (bepul) yoki claude (pullik)
AI_PROVIDER=groq

# Groq kaliti (bepul): https://console.groq.com/keys
GROQ_API_KEY=

# Gemini kaliti (faqat AI_PROVIDER=gemini bo'lsa): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude kaliti (faqat AI_PROVIDER=claude bo'lsa): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ixtiyoriy sozlamalar
PORT=3000
RATE_LIMIT_PER_MINUTE=15
# GAMMA_MODEL=openai/gpt-oss-120b
# Javob uzunligi chegarasi (token) va modelga yuboriladigan suhbat tarixi hajmi (belgi)
# MAX_OUTPUT_TOKENS=6000
# HISTORY_CHAR_BUDGET=16000
# Ochiq Wikipedia'dan ma'lumot olish (standart: yoqilgan). O'chirish: WIKIPEDIA=off
# WIKIPEDIA=on
# Wikipedia parchalari uchun ajratiladigan hajm (belgi; Groq uchun standart 2500)
# WIKI_CHAR_BUDGET=2500
# Rasm yaratish: GEMINI_API_KEY (Gemini, to'lov/billing yoqilgan bo'lishi kerak)
# va/yoki OPENAI_API_KEY (ChatGPT rasm modeli, https://platform.openai.com/api-keys).
# Ikkalasi ham bo'lsa, IMAGE_PROVIDER birinchi sinaladiganini tanlaydi, ikkinchisi zaxira.
# Hech biri bo'lmasa — rasm yaratish o'chiq.
OPENAI_API_KEY=
# IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# Suhbat sarlavhalarini yaratadigan model (Groq uchun standart: openai/gpt-oss-20b)
# TITLE_MODEL=openai/gpt-oss-20b
# IMAGE_RATE_LIMIT_PER_MINUTE=4
