# Ushbu faylni ".env" nomi bilan nusxalang va kalitingizni kiriting.

# Qaysi sun'iy intellekt ishlatiladi: groq (bepul), gemini (bepul) yoki claude (pullik)
AI_PROVIDER=groq

# Groq kaliti (bepul): https://console.groq.com/keys
GROQ_API_KEY=

# Gemini kaliti (faqat AI_PROVIDER=gemini bo'lsa): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude kaliti (faqat AI_PROVIDER=claude bo'lsa): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ixtiyoriy sozlamalar
PORT=3000
RATE_LIMIT_PER_MINUTE=15
# GAMMA_MODEL=openai/gpt-oss-120b
