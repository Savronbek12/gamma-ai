# Ushbu faylni ".env" nomi bilan nusxalang va kalitingizni kiriting.

# Qaysi sun'iy intellekt ishlatiladi: gemini (bepul) yoki claude (pullik)
AI_PROVIDER=gemini

# Gemini kaliti (bepul): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude kaliti (faqat AI_PROVIDER=claude bo'lsa kerak): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ixtiyoriy sozlamalar
PORT=3000
RATE_LIMIT_PER_MINUTE=15
# GAMMA_MODEL=gemini-3.8-flash
